+def _strategy_comment_stripped(content: str, pattern: str) -> List[Tuple[int, int]]:
+    """Match with comments stripped from both pattern and content."""
+    try:
+        from comment_strip_matcher import match_ignoring_comments
+    except ImportError:
+        return []
+
+    result = match_ignoring_comments(pattern, content)
+    if result is None:
+        return []
+
+    start_line, end_line = result
+    content_lines = content.split('\n')
+    start_pos, end_pos = _calculate_line_positions(
+        content_lines, start_line, end_line + 1, len(content)
+    )
+    return [(start_pos, end_pos)]
+
