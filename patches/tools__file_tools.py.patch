+def _thrice_auto_commit(paths: list[str], message_prefix: str) -> None:
+    """Best-effort auto-commit hook gated by HERMES_AUTO_COMMIT."""
+    if not paths:
+        return
+    try:
+        from auto_commit import AutoCommitManager, is_auto_commit_enabled
+        if not is_auto_commit_enabled():
+            return
+        first = os.path.abspath(paths[0])
+        manager = AutoCommitManager()
+        manager.enable(os.path.dirname(first) or ".")
+        for path in paths:
+            abs_path = os.path.abspath(path)
+            manager.on_file_edit(abs_path, f"{message_prefix} {os.path.basename(abs_path)}")
+    except ImportError:
+        pass
+    except Exception as exc:
+        logger.debug("auto_commit hook failed: %s", exc)
+
