+# =============================================================================
+# Cron Job State Machine
+# =============================================================================
+
+JOB_STATES = frozenset({"scheduled", "running", "paused", "completed", "failed", "error"})
+
+VALID_TRANSITIONS = {
+    "scheduled": {"running", "paused", "completed", "failed", "error"},
+    "running": {"scheduled", "completed", "failed", "error", "paused"},
+    "paused": {"scheduled"},
+    # Manual trigger/resume paths may revive terminal legacy jobs.
+    "completed": {"scheduled"},
+    "failed": {"scheduled", "paused", "running"},
+    "error": {"scheduled", "paused", "running"},
+}
+
+
+class InvalidTransitionError(ValueError):
+    """Raised when a cron job state transition is not allowed."""
+
+    def __init__(self, job_id: str, current: str, target: str):
+        self.job_id = job_id
+        self.current = current
+        self.target = target
+        allowed = VALID_TRANSITIONS.get(current, set())
+        super().__init__(
+            f"Invalid state transition for job '{job_id}': "
+            f"'{current}' -> '{target}' "
+            f"(allowed from '{current}': {sorted(allowed) if allowed else 'none'})"
+        )
+
+
+def is_valid_transition(current: str, target: str) -> bool:
+    """Check if a state transition is valid."""
+    if current == target:
+        return True
+    if current not in VALID_TRANSITIONS:
+        return False
+    return target in VALID_TRANSITIONS[current]
+
+
+def _guard_transition(job_id: str, current: str, target: str) -> None:
+    """Raise InvalidTransitionError if a cron job state transition is invalid."""
+    current = current or "scheduled"
+    target = target or "scheduled"
+    if not is_valid_transition(current, target):
+        logger.error(
+            "BLOCKED invalid transition for job '%s': '%s' -> '%s'",
+            job_id, current, target,
+        )
+        raise InvalidTransitionError(job_id, current, target)
+
+
+def job_is_active(job: Dict[str, Any]) -> bool:
+    """Return True when a cron job is eligible to run."""
+    state = job.get("state", "scheduled")
+    return bool(job.get("enabled", True)) and state not in {"paused", "completed", "failed", "error"}
+
+
+def _check_job_invariants(job: Dict[str, Any]) -> None:
+    """Best-effort invariant checks after cron job mutation."""
+    try:
+        from hermes_invariants import InvariantChecker
+        InvariantChecker.check_cron_invariants([job])
+    except ImportError:
+        pass
+    except Exception as exc:
+        logger.debug("Cron invariant checker failed for job %s: %s", job.get("id"), exc)
+
+    state = job.get("state", "scheduled")
+    if state not in JOB_STATES:
+        logger.error("INVARIANT VIOLATION: job '%s' has invalid state '%s'", job.get("id"), state)
+    if state == "completed" and job.get("next_run_at") is not None:
+        logger.warning("INVARIANT WARNING: completed job '%s' still has next_run_at", job.get("id"))
+
 
