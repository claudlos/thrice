+def _format_tool_exception(tool_name: str, exc: Exception) -> str:
+    """Format tool exceptions with Thrice structured errors when available."""
+    try:
+        from structured_errors import classify_error, format_error_result
+        return format_error_result(classify_error(exc, tool_name=tool_name))
+    except ImportError:
+        return f"Error executing tool '{tool_name}': {exc}"
+    except Exception as fmt_exc:
+        logger.debug("structured_errors formatting failed: %s", fmt_exc)
+        return f"Error executing tool '{tool_name}': {exc}"
+
+
+def _log_tool_selection(agent, tool_name: str, args: dict, result, duration: float, is_error: bool) -> None:
+    """Best-effort tool-call log for the Thrice tool selection model."""
+    try:
+        from hermes_constants import get_hermes_home
+        from tool_selection_model import ToolSelectionLogger
+        db_path = str(get_hermes_home() / "tool_calls.db")
+        ToolSelectionLogger(db_path).log_tool_call(
+            intent=getattr(agent, "_last_user_message", "")[:500],
+            tool_name=tool_name,
+            args=args,
+            success=not is_error,
+            duration=duration,
+        )
+    except ImportError:
+        pass
+    except Exception as exc:
+        logger.debug("Tool selection logging failed: %s", exc)
+
