+def _recover_stale_running_jobs() -> None:
+    """Recover jobs left in running state by a previous crash."""
+    from cron.jobs import load_jobs, save_jobs
+    import time as _time
+    from datetime import datetime, timezone
+
+    jobs = load_jobs()
+    recovered = 0
+    now = _time.time()
+    for job in jobs:
+        if job.get("state") != "running":
+            continue
+        last_run = job.get("running_since") or job.get("last_run_at")
+        if last_run:
+            try:
+                if isinstance(last_run, str):
+                    run_dt = datetime.fromisoformat(last_run)
+                    if run_dt.tzinfo is None:
+                        run_dt = run_dt.replace(tzinfo=timezone.utc)
+                else:
+                    run_dt = last_run
+                elapsed = now - run_dt.timestamp()
+            except Exception:
+                elapsed = _STALE_RUNNING_THRESHOLD_SECONDS + 1
+        else:
+            elapsed = _STALE_RUNNING_THRESHOLD_SECONDS + 1
+
+        if elapsed < _STALE_RUNNING_THRESHOLD_SECONDS:
+            logger.debug(
+                "Job '%s' (ID: %s) still running for %.0fs; not stale",
+                job.get("name", "?"), job.get("id", "?"), elapsed,
+            )
+            continue
+
+        logger.warning(
+            "Recovering stale running job '%s' (ID: %s); marking failed after %.0fs",
+            job.get("name", "?"), job.get("id", "?"), elapsed,
+        )
+        _guard_transition(job.get("id", "?"), "running", "failed")
+        job["state"] = "failed"
+        job["enabled"] = False
+        job["last_error"] = "Process crashed during execution (recovered on restart)"
+        job["last_status"] = "error"
+        recovered += 1
+    if recovered:
+        save_jobs(jobs)
+        logger.info("Recovered %d stale running cron job(s)", recovered)
+
+
