+    def _check_invariants(self) -> None:
+        """Best-effort process-registry invariant checks."""
+        try:
+            from hermes_invariants import InvariantChecker
+            InvariantChecker.check_process_registry(self._running, self._finished)
+        except ImportError:
+            pass
+        except Exception as exc:
+            logger.debug("Process registry invariant check failed: %s", exc)
+
+    def _check_reader_health(self, session: ProcessSession) -> bool:
+        """Detect reader threads that died without marking the session exited."""
+        if session is None or session.exited or session.detached:
+            return False
+        reader = getattr(session, "_reader_thread", None)
+        if reader is None or reader.is_alive():
+            return False
+
+        logger.warning(
+            "Reader thread for session %s (pid=%s, cmd=%r) died silently; marking exited",
+            session.id, session.pid, session.command,
+        )
+        session.exited = True
+        session.exit_code = -1
+        with session._lock:
+            session.output_buffer += (
+                "\n\n[hermes] Internal error: reader thread died unexpectedly. "
+                "Process output may be incomplete.\n"
+            )
+        self._move_to_finished(session)
+        return True
+
